<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>$(RootNamespace).Testing</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <!-- WireMock depends on Scriban.Signed transitively; keep this pinned only to avoid vulnerable transitive versions. -->
    <PackageReference Include="Scriban.Signed" Version="7.2.5" />
    <PackageReference Include="WireMock.Net.RestClient.AwesomeAssertions" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\Api.csproj" />
  </ItemGroup>
</Project>
